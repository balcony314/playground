# kubebuilder 项目元数据，供后续 kubebuilder 命令识别项目布局。
domain: oam.example.com
layout:
- go.kubebuilder.io/v4
plugins:
  manifests.sdk.operatorframework.io/v2: {}
  scorecard.sdk.operatorframework.io/v2: {}
projectName: oam
repo: github.com/balcony314/oam
resources:
- api:
    namespaced: true
    controller: true
    domain: oam
    kind: DeployUnit
    path: api/v1
    version: v1
- api:
    namespaced: true
    controller: false
    domain: oam
    kind: DeployUnitHistory
    path: api/v1
    version: v1
version: "3"
