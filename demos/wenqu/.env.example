# ===== LLM 网关 =====
# OpenRouter API Key（必填）
OPEN_AI_API_KEY=
# OpenRouter 模型名，默认 google/gemini-2.5-pro
MODEL_NAME=google/gemini-2.5-pro
# OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1

# ===== 自研 Embedding / Rerank =====
# BGE 风格 embedding 服务地址（必填，接口 POST {base}/embedding/{model}）
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=BAAI/bge-m3
# Rerank 服务（SiliconFlow 风格 POST {base}/reranker/{model}）
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== Milvus =====
MILVUS_ADDR=127.0.0.1:19530
MILVUS_DATABASE=default

# ===== Elasticsearch =====
ES_ADDR=http://127.0.0.1:9200
ES_USERNAME=
ES_PASSWORD=

# ===== ClickHouse（与 deploy/compose.yml 中保持一致）=====
CLICKHOUSE_ADDR=127.0.0.1:9000
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=default

# ===== ClickHouse MCP server =====
MCP_CLICKHOUSE_SSE_BASE_URL=http://127.0.0.1:4200/sse
MCP_CLICKHOUSE_TOOL_NAMES=list_databases,list_tables,run_select_query

# ===== 服务 =====
HTTP_LISTEN=127.0.0.1:5002
LOG_LEVEL=info
MAX_RETRY_PER_SOURCE=2
